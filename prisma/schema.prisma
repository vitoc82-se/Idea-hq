generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  mustChangePassword Boolean @default(false)
  // Invite-only access: the owner is always allowed; everyone else needs approval.
  approved      Boolean   @default(false)
  // Set when the welcome journey is finished or skipped.
  onboardingDismissed Boolean @default(false)
  // Daily cap on server-paid AI calls (estimate / plan / breakdown).
  aiCallsDay    String?   // YYYY-MM-DD (UTC) the counter applies to
  aiCallsToday  Int       @default(0)
  // Opt-in feature flags the owner grants per account (e.g. "tickets").
  features      String[]  @default([])
  // AI build: may this account start AI runs in its own GitHub (Implement, Learn deeply)?
  // Default on; the owner switches people off in the admin panel (a paywall can flip the default later).
  aiBuild       Boolean   @default(true)
  // Per-person daily cap on server-paid helper AI calls. null = the site default
  // (AI_DAILY_LIMIT, 20); 0 = off (also turns off AI answers in their Support widgets).
  aiDailyLimit  Int?
  // Billing (Lemon Squeezy). Only enforced when PAYWALL_ENABLED=1.
  // freeAccess: the owner waves this person through the paywall (friends and family).
  freeAccess    Boolean   @default(false)
  // Prepaid AI runs from the runs pack; one is used each time a run is approved.
  aiCredits     Int       @default(0)
  // Pro subscription mirror: Lemon Squeezy status, when access ends, and the
  // newest event time applied (older events that arrive late are ignored).
  subStatus     String?
  subEndsAt     DateTime?
  subUpdatedAt  DateTime?
  lsSubscriptionId String?
  lsPortalUrl   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  projects  Project[]
  ideas     Idea[]
  runs      Run[]
  installations GithubInstallation[]
}

// A project is one product this hub tracks ideas for (Snapmeal, Snitchbot,
// GrantFinder, ...). `context` is the per-project blob handed to Claude when it
// estimates an idea or writes a build prompt — the moving part that makes a
// cross-project estimate accurate. `contextUpdatedAt` drives stale detection:
// any idea whose aiEstimatedAt predates it was estimated against older context.
model Project {
  id               String   @id @default(cuid())
  userId           String
  name             String
  slug             String
  color            String?  // hex or tailwind token for the project chip
  context          String   @db.Text // ARCHITECTURE.md / stack / models / deploy — the AI grounding
  contextSourceUrl String?           // phase 2: raw URL of the repo's committed context file
  contextUpdatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Implement button: the GitHub repo this project ships to.
  repoOwner         String?
  repoName          String?
  installationId    Int?     // GitHub App installation id
  envBranches       Json?    // { "test": "develop", "live": "main" } environment -> base branch
  defaultEnv        String?
  autoMerge         Boolean  @default(false) // opt-in: merge when all required checks are green
  buildCommand      String?
  testCommand       String?
  workflowInstalled Boolean  @default(false) // setup PR merged and workflow present
  setupPrNumber     Int?
  commandsConfirmed Boolean  @default(false) // build/test commands reviewed in the setup journey
  knowledge         Json?    // structured project knowledge (see src/lib/knowledge.ts)
  knowledgePrNumber Int?     // open PR that saves the knowledge into the repo
  aiProvider        String   @default("claude") // claude | openai (see src/lib/providers)
  secretConfirmed   Boolean  @default(false) // ANTHROPIC_API_KEY seen in the repo's secrets
  aiBias            String   @default("auto") // saver | auto | max: shifts the model tier

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideas Idea[]
  runs  Run[]
  memory ProjectMemory[]
  support SupportSpace?
  tickets Ticket[]

  @@unique([userId, slug])
  @@index([userId])
}

model Idea {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  title     String
  notes     String?  // longer description / detail
  status    String   @default("new") // new, considering, building, done, parked
  priority  String   @default("none") // none, low, medium, high (you set this)
  tags      String[] @default([]) // freeform themes (ios, ai, growth…), AI-suggested + editable
  blockedBy String[] @default([]) // ids of ideas that must ship first
  // Breakdown: an idea can be split into ordered child "stories". When it has
  // children it is an "epic" (a container). parentId points a story at its epic.
  parentId  String?
  // AI estimate (filled in the background after you submit):
  complexity    String?   // S, M, L, XL (effort)
  impact        String?   // low, medium, high (value/impact — AI-suggested, you can override)
  scope         String?   // implementation-scope summary
  aiEstimatedAt DateTime?
  // "Promote to plan" output:
  plan          String?   @db.Text // AI-generated build prompt (markdown)
  plannedAt     DateTime?
  // Closure: a short free-text "what shipped / why done" note, stamped when the
  // idea moves to done. Preserved if it later moves off done; closedAt is cleared.
  closureNote   String?   @db.Text
  closedAt      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs     Run[]
  parent   Idea?   @relation("IdeaChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Idea[]  @relation("IdeaChildren")

  @@index([userId, projectId, status])
  @@index([parentId])
}

// One AI implementation attempt on an idea. Driven by GitHub webhooks (see
// src/lib/runs/state.ts for the legal transitions).
model Run {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  ideaId       String?
  kind         String    @default("implement") // setup | implement | revise | revert
  status       String    @default("queued")
  env          String?
  baseBranch   String?
  branch       String?
  plan         String?   @db.Text // snapshot of the approved plan / instruction
  ghRunId      String?   // GitHub Actions run id
  prNumber     Int?
  headSha      String?
  mergedSha    String?
  costUsd      Float?
  turns        Int?
  provider     String?   // claude | openai
  model        String?   // model the run was dispatched with
  effort       String?
  maxTurns     Int?
  checksState  String?   // pending | green | red
  creditCharged Boolean  @default(false) // a runs-pack credit paid for this run (refunded if it fails)
  error        String?   @db.Text
  parentRunId  String?   // revise/revert point at the run they follow
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idea    Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([ideaId])
  @@index([userId])
}

// Idempotency ledger for GitHub webhook deliveries (X-GitHub-Delivery).
model WebhookDelivery {
  id        String   @id
  createdAt DateTime @default(now())
}

// A GitHub App installation the user proved (via GitHub OAuth) they can see.
model GithubInstallation {
  id           Int      @default(0)
  userId       String
  accountLogin String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

// What Idea HQ has learned while working on a project: shipped changes, lessons
// from corrections and failures, and facts the owner pinned. Feeds the context
// the AI reads (src/lib/knowledge.ts assembleContext).
model ProjectMemory {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  kind      String   @default("change") // change | lesson | gotcha | decision | user
  text      String   @db.Text
  pinned    Boolean  @default(false)
  source    String   @default("auto")   // auto | you
  runId     String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---- Support tickets (see src/lib/support). The public widget reaches these
// tables only through src/lib/support/public-store.ts.

// One per project: switches support on and holds the widget settings.
model SupportSpace {
  id               String   @id @default(cuid())
  projectId        String   @unique
  enabled          Boolean  @default(false)
  publicKey        String   @unique   // appears in the embed code; not a secret
  allowedOrigins   String[] @default([]) // sites allowed to frame the widget
  title            String   @default("Support")
  brandColor       String   @default("#047857")
  logoUrl          String?
  theme            String   @default("auto") // auto | light | dark
  formSchema       Json?
  aiEnabled        Boolean  @default(false)
  aiDailyCap       Int      @default(50)
  retentionDays    Int      @default(365)
  notifyEmail      String?
  replyTimeNote    String?
  supportKnowledge Json?    // owner-reviewed help notes; only confirmed ones reach customers
  ticketCounter    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Ticket {
  id             String    @id @default(cuid())
  projectId      String
  number         Int
  status         String    @default("open") // open | pending | resolved | closed
  subject        String
  customerEmail  String
  customerName   String?
  fields         Json
  needsHuman     Boolean   @default(true)
  aiAnswered     Boolean   @default(false)
  unread         Boolean   @default(true)  // owner has not opened the latest customer activity
  tokenHash      String    @unique         // sha256 of the customer's private link token
  lastActivityAt DateTime  @default(now())
  closedAt       DateTime?     // set when resolved or closed; retention counts from here
  createdAt      DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, customerEmail])
  @@index([projectId, closedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  author    String   // customer | owner | ai
  body      String   @db.Text // plain text only
  aiMeta    Json?
  emailedAt DateTime?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Fixed-window counters for public-route rate limits (keys hold hashed ids only).
model RateBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
}

// One row per payment event already applied (Lemon Squeezy retries webhooks),
// so a credit pack is never granted twice. id = "order:<id>" or "refund:<id>".
model BillingEvent {
  id        String   @id
  userId    String?
  createdAt DateTime @default(now())
}
