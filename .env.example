# Copy to .env (gitignored) and fill in. Set the same values in Vercel.

# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"   # your Vercel URL in production

# Anthropic API key — powers idea estimation + build-prompt generation
ANTHROPIC_API_KEY="sk-ant-..."

# Owner lock: only this email can see the hub. Optional — if unset, the first
# account to register becomes the owner.
OWNER_EMAIL="you@example.com"

# Optional: enable the "Continue with Google" button on sign-in
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
