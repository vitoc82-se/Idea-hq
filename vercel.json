{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/support-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/stuck-runs",
      "schedule": "30 3 * * *"
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in dependabot/*) exit 0;; *) exit 1;; esac"
}
